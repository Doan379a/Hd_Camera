<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="17sp"
        android:layout_marginVertical="10dp"
        android:background="@drawable/bg_dialog_result_spin_wheel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="17sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center|center_vertical"
                android:includeFontPadding="false"
                android:text="we_have_a_winner"
                android:fontFamily="@font/barlow_bold_700"
                android:paddingVertical="@dimen/_10sdp"
                android:layout_gravity="center"
                android:textColor="#FFF6D3"
                android:textSize="@dimen/_18ssp" />

            <ImageView
                android:id="@+id/img_close"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/_10sdp"
                android:visibility="gone"
                android:src="@drawable/ic_back" />
        </LinearLayout>


        <TextView
            android:id="@+id/tv_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="17sp"
            android:layout_marginVertical="15sp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:fontFamily="@font/barlow_medium_500"
            android:paddingVertical="13sp"
            tools:text="@string/go_to_setting"
            android:textColor="#E4E4E4"
            android:textSize="@dimen/_16ssp" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>