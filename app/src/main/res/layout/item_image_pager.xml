<?xml version="1.0" encoding="utf-8"?>
<com.beautycam.hdcam.photoeditor.library.zoomimg.views.GestureFrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</com.beautycam.hdcam.photoeditor.library.zoomimg.views.GestureFrameLayout>
