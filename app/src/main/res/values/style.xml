<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BaseDialog" parent="Theme.AppCompat.Light.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
    </style>

    <style name="RatingBar" parent="Theme.AppCompat">
        <item name="colorControlNormal">#5A5A5A</item>
        <item name="colorControlActivated">#FFF732</item>
    </style>
    <style name="RoundedImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50dp</item>
    </style>

    <style name="KeyButton">
        <item name="android:layout_width">60dp</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:textSize">32sp</item>
        <item name="android:fontFamily">@font/barlow_semibold_600</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:background">@drawable/bg_btn_number</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:layout_marginLeft">30dp</item>
        <item name="android:layout_marginRight">30dp</item>
        <item name="android:layout_marginBottom">5dp</item>
    </style>


</resources>